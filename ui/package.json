    "i18n:check": "node packages/shared/scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@trussworks/react-uswds": "^13.0.0",
    "@uswds/uswds": "^3.14.0",
    "focus-trap-react": "^11.0.6",
    "i18next": "^26.5.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.64.1",
    "sass-embedded": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
