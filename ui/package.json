{
  "name": "sure-vote-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:public": "npm run dev -w @surevote/public",
    "dev:workspace": "npm run dev -w @surevote/workspace",
